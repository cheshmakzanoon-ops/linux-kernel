# Nimbus OS look-and-feel defaults (dark variant, no layouts: panels are kept)

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=NimbusDark

[kdeglobals][Icons]
Theme=Papirus-Dark

[plasmarc][Theme]
name=default

[Wallpaper]
Image=Nimbus

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][WindowSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=XIA
ButtonsOnRight=
