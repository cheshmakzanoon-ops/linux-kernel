# Nimbus OS system-wide global shortcut defaults (Plasma 6, kglobalaccel).
# Format for component groups: Action=<active keys>,<default keys>,<friendly name>
# Multiple keys are separated by \t. "none" unbinds an action.
# Meta+Q is intentionally NOT global: apps handle quit themselves.

[kwin]
_k_friendly_name=KWin
Walk Through Windows=Meta+Tab\tAlt+Tab,Alt+Tab,Walk Through Windows
Walk Through Windows (Reverse)=Meta+Shift+Tab\tAlt+Shift+Tab,Alt+Shift+Tab,Walk Through Windows (Reverse)
Walk Through Windows of Current Application=Meta+`\tAlt+`,Alt+`,Walk Through Windows of Current Application
Walk Through Windows of Current Application (Reverse)=Meta+~\tAlt+~,Alt+~,Walk Through Windows of Current Application (Reverse)
Overview=Meta+Up\tMeta+W,Meta+W,Toggle Overview
Window Quick Tile Top=none,Meta+Up,Quick Tile Window to the Top
Switch One Desktop to the Left=Ctrl+Left\tMeta+Ctrl+Left,Meta+Ctrl+Left,Switch One Desktop to the Left
Switch One Desktop to the Right=Ctrl+Right\tMeta+Ctrl+Right,Meta+Ctrl+Right,Switch One Desktop to the Right

[plasmashell]
_k_friendly_name=plasmashell
next activity=none,Meta+Tab,Walk through activities
previous activity=none,Meta+Shift+Tab,Walk through activities (Reverse)
manage activities=none,Meta+Q,Show Activity Switcher

[ksmserver]
_k_friendly_name=Session Management
Lock Session=Meta+Ctrl+Q\tMeta+L\tScreensaver,Meta+L\tScreensaver,Lock Session

[services][org.kde.krunner.desktop]
_launch=Meta+Space\tAlt+Space\tAlt+F2\tSearch

# Meta+# / Meta+$ are the US-layout keysyms produced by Meta+Shift+3 / Meta+Shift+4.
[services][org.kde.spectacle.desktop]
FullScreenScreenShot=Meta+Shift+3\tMeta+#\tShift+Print
RectangularRegionScreenShot=Meta+Shift+4\tMeta+$\tMeta+Shift+Print
