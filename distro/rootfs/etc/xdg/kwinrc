# Nimbus OS window manager defaults

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
# X = close, I = minimize, A = maximize
ButtonsOnLeft=XIA
ButtonsOnRight=

[Plugins]
wobblywindowsEnabled=false
squashEnabled=false
magiclampEnabled=true
overviewEnabled=true
blurEnabled=true
contrastEnabled=true
translucencyEnabled=false

[Effect-blur]
BlurStrength=10
NoiseStrength=2

# Overview on the top-left hot corner (ElectricTopLeft = 7)
[Effect-overview]
BorderActivate=7

[ElectricBorders]
TopLeft=None
